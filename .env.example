LLM_API_KEY=your_key_here
LLM_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
LLM_VISION_MODEL=Qwen/Qwen3-VL-235B-A22B-Instruct
# Use a local directory by default; replace this with your Obsidian vault path.
VAULT_PATH=./.vault
INDEX_PATH=./.vke_index

# Autonomous Discovery
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL=3600
INTEREST_HUB_TOP_K=15
INTEREST_LEAF_TOP_K=10
INTEREST_REFRESH_INTERVAL=21600
MAX_URLS_PER_CYCLE=10
